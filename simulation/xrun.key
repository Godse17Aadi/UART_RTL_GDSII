database -open waves -into waves.shm -default
probe -create -shm uart_tb.uut.address uart_tb.uut.baud_division uart_tb.uut.baud_tick uart_tb.uut.clk uart_tb.uut.data_in uart_tb.uut.data_out uart_tb.uut.enable uart_tb.uut.re uart_tb.uut.read_data uart_tb.uut.rst uart_tb.uut.rx uart_tb.uut.tx uart_tb.uut.we uart_tb.uut.write_data
run
exit
